# Runtime backend: DockSync uses Rclone for Proton Drive integration.
SYNC_BACKEND=rclone
SYNC_LOCAL_PATH=/data
SYNC_REMOTE_PATH=/DockSync
STATE_DIR=/state
SYNC_INTERVAL_SECONDS=300
SYNC_ONCE=false

# Conflict handling: newer-wins, local-wins, or remote-wins.
CONFLICT_STRATEGY=newer-wins

# Optional transfer throttle. Use 0 for unlimited.
BANDWIDTH_LIMIT_BYTES_PER_SECOND=0

# Health/status HTTP server and manual sync trigger.
API_HOST=0.0.0.0
API_PORT=8080
ENABLE_REST_API=true

# Retry policy for failed syncs.
RETRY_MAX_ATTEMPTS=5
RETRY_INITIAL_DELAY_MS=1000
RETRY_MAX_DELAY_MS=60000

# Optional error notification webhook. Prefer ERROR_WEBHOOK_URL_FILE in Docker.
# ERROR_WEBHOOK_URL_FILE=/run/secrets/docksync_error_webhook

# Configure Proton Drive on the host with `rclone config`, then mount the
# generated config at /config/rclone/rclone.conf.
RCLONE_REMOTE=proton:
RCLONE_CONFIG=/config/rclone/rclone.conf
# RCLONE_CONFIG_PASS_FILE=/run/secrets/rclone_config_pass
RCLONE_CACHE_DIR=/state/rclone-cache
RCLONE_SERIAL_TRANSFERS=false
